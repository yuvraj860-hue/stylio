# ── API endpoints ──────────────────────────────────────────────────────────────
# Used by the built app (production). Leave empty to use same-origin /api paths
# (works with the Vite dev proxy or when the backend is served from the same origin).
VITE_API_BASE=
VITE_ML_BASE=

# ── Vite dev proxy targets (local development only) ───────────────────────────
VITE_API_TARGET=http://localhost:5000
VITE_ML_TARGET=http://localhost:8000

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Optional publishable key. If left empty the checkout page gracefully falls
# back to a mock "Place Order" flow.
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Razorpay ───────────────────────────────────────────────────────────────────
# Optional Razorpay key ID (from dashboard.razorpay.com). When set, checkout
# uses Razorpay. Takes precedence over Stripe when both are configured.
VITE_RAZORPAY_KEY_ID=

# ── Clerk ──────────────────────────────────────────────────────────────────────
# Public key from Clerk dashboard. Required for auth flows.
VITE_PUBLIC_CLERK_PUBLISHABLE_KEY=