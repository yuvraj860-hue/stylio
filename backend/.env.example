# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (use direct connection string, not SRV, if DNS blocked)
MONGO_URI=mongodb://username:password@host:port/dbname?retryWrites=true&w=majority

# ── CORS ────────────────────────────────────────────────────────────────
# Frontend URL (Vercel production URL)
CORS_ORIGIN=https://stylio-hazel.vercel.app

# ── Clerk Authentication (REQUIRED) ─────────────────────────────────────
# Get from Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# ── Razorpay Payments ───────────────────────────────────────────────────
# Get from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── AI Stylist (Groq) ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Brevo) ───────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=STYLIO <no-reply@stylio.in>

# ── Frontend URL (for emails, webhooks) ─────────────────────────────────
FRONTEND_URL=https://stylio-hazel.vercel.app

# ── Optional: Stripe (if using) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ── Optional: ML Service ────────────────────────────────────────────────
ML_SERVICE_URL=